{
  "name": "manhunt-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Game server for an outdoor GPS chase game (chasers vs runners).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "bots": "node scripts/bots.ts"
  },
  "dependencies": {
    "ws": "^8.22.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
